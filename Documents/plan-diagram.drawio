  <diagram name="페이지-1" id="dNxFR5Y_9yTIsznD_FAm">
    <mxGraphModel dx="1710" dy="1250" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-13" value="주요 System 카테고리" style="swimlane;whiteSpace=wrap;html=1;fontSize=20;startSize=40;verticalAlign=middle;fillColor=#B0B0B0;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="340" height="770" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-8" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Job System&lt;/h1&gt;&lt;p&gt;스레드간 job 분배 시스템&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="50" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-15" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Physics Systems + Logics&lt;/h1&gt;&lt;p&gt;빌트인 물리 시스템 기반&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;이동 및 충돌/피격 처리 등 핵심 게임 로직 처리 시스템&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;strokeWidth=2;verticalAlign=middle;fillColor=#DDDDDD;fillStyle=auto;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="140" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-18" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;AI System&lt;/h1&gt;&lt;p&gt;행동트리 기반 적/드론/투사체 등 AI 행동 계산 시스템&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="320" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-17" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Controller System&lt;/h1&gt;&lt;p&gt;플레이어 입력 및 AI 입력 기반 기체 컨트롤 시스템&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="230" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-19" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;UI System&lt;/h1&gt;&lt;p&gt;UI 요소 관리 시스템&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="590" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-20" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Stage-related System&lt;/h1&gt;&lt;p&gt;스테이지 및 전반적인 게임 진행 관련 총괄 시스템&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="680" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-46" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Audio System&lt;/h1&gt;&lt;p&gt;큐 기반 소리 (출력) 처리 시스템&lt;br&gt;타 시스템에서 큐잉된 오디오 요청을 메인 스레드에서 처리&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="500" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-50" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Graphics System&lt;/h1&gt;&lt;p&gt;렌더링, 시각효과, 후처리 등 그래픽 출력 처리 시스템&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-13">
          <mxGeometry x="10" y="410" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-22" value="주요 Component 카테고리" style="swimlane;whiteSpace=wrap;html=1;fontSize=20;startSize=40;verticalAlign=middle;fillColor=#B0B0B0;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="380" height="680" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-6" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Physics-related components&lt;/h1&gt;&lt;p&gt;이동속도, 위치, 지향각, 강체 정보 등 물리 관련 값들&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-22">
          <mxGeometry x="10" y="50" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-21" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Mech-specific components&lt;/h1&gt;&lt;p&gt;현재 체력, 선택중인 무장, 무장 게이지 등 상태 관련 값들 및&lt;br&gt;기체 및 무장 정보 blob asset 참조값들 (시간 관련 값은 분리)&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-22">
          <mxGeometry x="10" y="230" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-30" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Timer components&lt;/h1&gt;&lt;p&gt;현재 게임 시간, 최근 무장 발사 시각 등 런타임 환경 시간 관련 값들&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-22">
          <mxGeometry x="10" y="140" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-31" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Projectile-specific components&lt;/h1&gt;&lt;p&gt;현재 투사체 상태 관련 값들&lt;br&gt;및 투사체 정보 blob asset 참조값들 (시간 관련 값은 분리)&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-22">
          <mxGeometry x="10" y="320" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-33" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;AI-related components&lt;/h1&gt;&lt;p&gt;행동트리 blob asset, 현재 트리 위치 및 상태 등 AI 관련 값들&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(시간 관련 값은 분리)&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-22">
          <mxGeometry x="10" y="410" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-16" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Renderer-related components&lt;/h1&gt;&lt;p&gt;스프라이트 애셋, uv 좌표 기반 애니메이션 정보 등 렌더링 관련 값들&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-22">
          <mxGeometry x="10" y="500" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="3aV2kbsRSpF0gq9MLwRu-47" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Sound components&lt;/h1&gt;&lt;p&gt;음성 클립 애셋 등 소리 관련 값들&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;verticalAlign=middle;" vertex="1" parent="3aV2kbsRSpF0gq9MLwRu-22">
          <mxGeometry x="10" y="590" width="360" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
