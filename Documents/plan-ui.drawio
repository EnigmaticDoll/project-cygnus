        <mxCell id="LveYrARpPu0S0ZiUOOyu-3" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF6666;" parent="1" vertex="1">
          <mxGeometry x="310" y="380" width="20" height="40" as="geometry" />
        </mxCell>
        <mxCell id="LveYrARpPu0S0ZiUOOyu-4" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;적 메카&lt;/h1&gt;&lt;p&gt;플레이어와 마찬가지로 대시 및 점프 가능&lt;/p&gt;&lt;p&gt;조무래기는 무장도 단순하고 스탯도 약함&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;강적은 무장도 다양하고 스텟도 강력&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/p&gt;행동 트리 기반 AI로 동작&lt;br&gt;강적은 숫자가 적은 대신 더 까다롭게" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="550" y="525" width="210" height="135" as="geometry" />
        </mxCell>
        <mxCell id="LveYrARpPu0S0ZiUOOyu-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="LveYrARpPu0S0ZiUOOyu-4" target="LveYrARpPu0S0ZiUOOyu-2" edge="1">
