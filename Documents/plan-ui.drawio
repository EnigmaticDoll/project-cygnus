        <mxCell id="T_0B7SM_JZePn8a4O3Mm-10" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;무장 (그 외)&lt;/h1&gt;&lt;p&gt;사용자가 선택중인 무장 이외의 무장&lt;/p&gt;&lt;p&gt;그 외 사항은 마찬가지&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;" vertex="1" parent="T_0B7SM_JZePn8a4O3Mm-1">
          <mxGeometry x="450" y="470" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="T_0B7SM_JZePn8a4O3Mm-11" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;무장 (선택중)&lt;/h1&gt;&lt;p&gt;선택중인 무장은 크기 확대 및 강조하여 표시&lt;/p&gt;&lt;p&gt;발사 가능한 분량이 충분한 경우 청색 표시, 부족한 경우 적색 표시&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;잔탄식: 전부 소진 후 충전&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;게이지식: 항시 충전&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;align=right;" vertex="1" parent="T_0B7SM_JZePn8a4O3Mm-1">
          <mxGeometry x="120" y="470" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="T_0B7SM_JZePn8a4O3Mm-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="T_0B7SM_JZePn8a4O3Mm-1" source="T_0B7SM_JZePn8a4O3Mm-11" target="T_0B7SM_JZePn8a4O3Mm-6">
