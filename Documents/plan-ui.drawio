          <mxGeometry x="430" y="520" width="20" height="40" as="geometry" />
        </mxCell>
        <mxCell id="zAiO2ubE1Ik8upDE7GPC-15" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;플레이어 메카&lt;/h1&gt;&lt;p&gt;이동시 카메라가 자동으로 따라가며&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;shift 키로 줌아웃 가능&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;지향 방향에 따라 스프라이트 변경&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;대시 및 점프 가능하며 점&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;프는 위치 변화, 하단 그림자 표시와 더불어 주변 다른 층에 흐림 효과 처리를 넣는 것으로 표현&lt;/span&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=10;align=right;" parent="1" vertex="1">
          <mxGeometry x="130" y="500" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="zAiO2ubE1Ik8upDE7GPC-17" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" parent="1" source="LveYrARpPu0S0ZiUOOyu-4" target="LveYrARpPu0S0ZiUOOyu-1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="500" />
              <mxPoint x="640" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="zAiO2ubE1Ik8upDE7GPC-18" value="2D isometric 뷰" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="130" y="370" width="100" height="30" as="geometry" />
